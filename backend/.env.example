# Configuración de base de datos PostgreSQL
# Reemplazar con las credenciales correspondientes en producción
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/desarrollo_rural_nayarit?schema=public"

# Puerto de escucha del servidor
PORT=5000

# Clave secreta para firmar los tokens JWT.
# ¡IMPORTANTE! Debe ser una cadena de texto larga y aleatoria.
# Generar una con el comando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplazar_con_un_secreto_seguro_generado_aleatoriamente"

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS="http://localhost:5173"
